#!/command/with-contenv sh
set -euo pipefail

echo "Running Nginx initialization..."

# Wait for mailinabox service to be ready
if command -v nc >/dev/null 2>&1; then
    echo "Waiting for mailinabox service..."
    MAX_WAIT=30
    WAIT_COUNT=0
    while ! nc -z mailinabox 10222 2>/dev/null && [ $WAIT_COUNT -lt $MAX_WAIT ]; do
        echo "Waiting for mailinabox:10222... ($WAIT_COUNT/$MAX_WAIT)"
        sleep 1
        WAIT_COUNT=$((WAIT_COUNT + 1))
    done
    if [ $WAIT_COUNT -lt $MAX_WAIT ]; then
        echo "mailinabox service is ready"
    else
        echo "Warning: mailinabox service not ready after ${MAX_WAIT}s, continuing anyway"
    fi
fi

# Wait for nginx config file from mailinabox management daemon
# Configs are generated by web_update.py and mounted via shared volume
echo "Waiting for nginx configuration from mailinabox..."
MAX_WAIT=60
WAIT_COUNT=0
while [ ! -f /etc/nginx/conf.d/local.conf ] && [ $WAIT_COUNT -lt $MAX_WAIT ]; do
    echo "Waiting for /etc/nginx/conf.d/local.conf... ($WAIT_COUNT/$MAX_WAIT)"
    sleep 1
    WAIT_COUNT=$((WAIT_COUNT + 1))
done

if [ -f /etc/nginx/conf.d/local.conf ]; then
    echo "Nginx configuration found"
    # Test nginx configuration
    if nginx -t 2>/dev/null; then
        echo "Nginx configuration is valid"
    else
        echo "Warning: nginx configuration test failed"
        nginx -t || true
    fi
else
    echo "Warning: nginx configuration not found after ${MAX_WAIT}s, nginx may not start correctly"
fi

echo "Nginx initialization complete."

