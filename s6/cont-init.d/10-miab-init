#!/command/with-contenv bash
# Exit immediately on any error, treat unset variables as errors, and fail pipelines
set -euo pipefail

# Also enable error tracing for debugging
set -x

echo "Running MIAB init"

# Helper function to check required environment variables and fail if missing
check_required_env() {
	local var_name="$1"
	local var_value="${!var_name:-}"
	if [ -z "$var_value" ]; then
		echo "ERROR: Required environment variable '$var_name' is not set" >&2
		echo "ERROR: Init script will exit with failure" >&2
		return 1
	fi
}

# Check required environment variables - exit immediately if missing
check_required_env "STORAGE_ROOT" || exit 1
check_required_env "PRIMARY_HOSTNAME" || exit 1

IN_KUBERNETES="${IN_KUBERNETES:-false}"
if [ "${IN_KUBERNETES}" = "true" ]; then
    # Get the PUBLIC_IP and PUBLIC_IPV6 from Kubernetes
    # Python script writes to /tmp/gateway-ips.sh (writable location)
    # for container-wide availability
    /usr/local/lib/mailinabox/env/bin/python3 /opt/entrypoint/get_gateway_ip.py
    GATEWAY_IP_EXIT_CODE=$?

    # Source the script file to load variables into current shell
    # This makes PUBLIC_IP and PUBLIC_IPV6 available to all subsequent scripts
    if [ -f "/tmp/gateway-ips.sh" ]; then
        source /tmp/gateway-ips.sh
        echo "Loaded Gateway IPs from /tmp/gateway-ips.sh"
    else
        # Fallback: script might have printed export statements to stdout
        # In this case, variables should already be set from the script's output
        echo "Warning: /tmp/gateway-ips.sh not found, using environment from script" >&2
    fi

    # Ensure variables are exported for all subsequent scripts
    export PUBLIC_IP="${PUBLIC_IP:-}"
    export PUBLIC_IPV6="${PUBLIC_IPV6:-}"

    # Log the values
    echo "Gateway IPs set: PUBLIC_IP=${PUBLIC_IP:-<empty>}, PUBLIC_IPV6=${PUBLIC_IPV6:-<empty>}"

    # Warn if script failed and no IPs were set
    if [ -z "${PUBLIC_IP:-}" ] && [ "$GATEWAY_IP_EXIT_CODE" -ne 0 ]; then
        echo "WARNING: Gateway IPs not found, PUBLIC_IP is empty. Some services may not work correctly." >&2
    fi
else
    check_required_env "PUBLIC_IP" || exit 1
    # check_required_env "PUBLIC_IPV6" || exit 1
fi

# Set default MTA_STS_MODE if not provided
export MTA_STS_MODE="${MTA_STS_MODE:-enforce}"

# Configure /etc/resolv.conf to use bind9 sidecar if enabled
# With dnsPolicy: None, Kubernetes does NOT create or manage /etc/resolv.conf
# This file is fully writable and will not be replaced by Kubernetes
# bind9 sidecar listens on 127.0.0.1:53 and validates DNSSEC while forwarding to kube-dns
if [ "${ENABLE_INTERNAL_BIND:-false}" = "true" ] || [ -n "${BIND_SIDECAR_ENABLED:-}" ]; then
    RESOLVER="127.0.0.1"
    printf "nameserver %s\n" "$RESOLVER" > /etc/resolv.conf
    chmod 644 /etc/resolv.conf
    echo "Configured /etc/resolv.conf to use bind9 at $RESOLVER (writable, not managed by Kubernetes)"
fi

cd /opt/MailInABox

# Prepare storage user, data root, and initial configuration
bash /opt/entrypoint/setup_storage.sh

# Create a backup directory and a random key for encrypting backups.
mkdir -p "$STORAGE_ROOT/backup"
if [ ! -f "$STORAGE_ROOT/backup/secret_key.txt" ]; then
	(umask 077; openssl rand -base64 2048 > "$STORAGE_ROOT/backup/secret_key.txt")
fi

# It creates the mail/users.sqlite database and the tables if needed.
bash /opt/entrypoint/setup_mail_users_runtime.sh

bash /opt/entrypoint/setup_mail_postfix_runtime.sh
bash /opt/entrypoint/setup_mail_dovecot_runtime.sh

# It creates the mail/dkim directory and the DKIM key.
bash /opt/entrypoint/setup_dkim_runtime.sh

# Generate default SSL assets (optional)
bash /opt/entrypoint/setup_ssl_runtime.sh

echo "DEBUG: MIAB init completed"

# It writes the mailinabox.version file to the storage root,
# and do the migrations if needed.
python3 /opt/entrypoint/migrate.py

# Remove the down file to allow s6 to restart the service
rm -rf /etc/services.d/web-update-init/down
