#!/command/with-contenv sh
set -eu

IN_KUBERNETES="${IN_KUBERNETES:-false}"
if [ "${IN_KUBERNETES}" = "true" ]; then
    # Run every 5 seconds to sync system user from Kubernetes secret to SQLite database
    # Use venv Python to access kubernetes library
    /usr/local/lib/mailinabox/env/bin/python3 /opt/entrypoint/get_user_secret.py

    # Exit after 5 seconds to restart the service
    sleep 5
else
    echo "DEBUG (set_system_user): IN_KUBERNETES=false, downing service"
    # If we are not in a Kubernetes environment, down the service BEFORE exiting to prevent s6 from restarting
    # The service directory exists at /run/service/set-system-user when the service is active
    if [ -d /run/service/set-system-user ]; then
        s6-svc -d /run/service/set-system-user 2>/dev/null || echo "Note: Could not down service (might already be down)" >&2
    fi
    # Also create down file as safeguard
    touch /etc/services.d/set-system-user/down 2>/dev/null || true
fi

exit 0
